{
  "name": "solophp/router",
  "type": "library",
  "description": "PHP router with an independent route builder, immutable runtime, typed results, and compiled matching.",
  "keywords": [
    "router",
    "routing",
    "http",
    "immutable",
    "route-groups",
    "named-routes",
    "php8"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Vitaliy Olos",
      "email": "vedastudio@gmail.com",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Solo\\Router\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Solo\\Router\\Test\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.9"
  },
  "scripts": {
    "cs-check": "phpcs --standard=PSR12 src/",
    "cs-fix": "phpcbf --standard=PSR12 src/",
    "analyze": "phpstan analyze",
    "test": [
      "@cs-check",
      "@analyze",
      "phpunit"
    ]
  },
  "homepage": "https://github.com/SoloPHP/Router",
  "support": {
    "issues": "https://github.com/SoloPHP/Router/issues",
    "source": "https://github.com/SoloPHP/Router",
    "docs": "https://solophp.github.io/Router/"
  },
  "config": {
    "sort-packages": true
  }
}
